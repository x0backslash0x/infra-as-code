# Generated by anaconda 34.25.5.9
# Generated by pykickstart v3.32
#version=RHEL9
# pre-installation script for wiping disk
## this should get rid of existing partitions but does not always work for letting anaconda continue with partitioning
%pre
for disk in /dev/sd[a-z]; do
    dd if=/dev/zero of=$disk bs=512 count=2048
    wipefs -a $disk
    udevadm settle
done
%end

# Use graphical install
graphical

%addon com_redhat_kdump --enable --reserve-mb='auto'

%end

# Keyboard layouts
keyboard --xlayouts='be (nodeadkeys)'
# System language
lang en_US.UTF-8

# Network information
network  --bootproto=dhcp --device=ens160 --ipv6=auto --activate
network  --hostname=rocky9

%packages
@^graphical-server-environment

%end

# Run the Setup Agent on first boot
firstboot --enable

# Generated using Blivet version 3.6.0
ignoredisk --only-use=sda

# Partition clearing information
clearpart --all

# select auto partitioning scheme
autopart

# System timezone
timezone Europe/Brussels --utc

# Root password
rootpw --iscrypted $6$kNtKQoYiv5MZiF9Q$HYTXKmlP9/ukO5wRoPAxzefuAoJRdPzTSA2StikidAFYzzUSbts66diCvYAVBmvC6Yqn7DCfXuh1ogTIUy2GH1
user --name=rocky --password=$6$sSnWH4EppblfMjVD$4nUkIERknqzYHPw/Xnc5cGC2Qj40tgDhq8Ac8LvW7PdxC/CWpT0zdPAgSHxeWOz6LyTH8UNoctl0A0pZ53Ee9. --iscrypted --gecos="rocky"
