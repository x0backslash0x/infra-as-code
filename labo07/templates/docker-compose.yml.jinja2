name: "labo 7"
services:
  proxy:
    image: nginx
    volumes:
      - ./nginx/default-http.conf:/etc/nginx/conf.d/default.conf
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf
    ports:
      - 80:80
  cms1:
    image: wordpress
    volumes:
      - ./wp/:/var/www/html/
    environment:
      - WORDPRESS_DB_HOST=database
      - WORDPRESS_DB_USER=${db_user}
      - WORDPRESS_DB_PASSWORD=${db_pass}
      - WORDPRESS_DB_NAME=${db_name}
      - WORDPRESS_TABLE_PREFIX=wp
      - WORDPRESS_CONFIG_EXTRA=define('WP_HOME','http://localhost/cms');define('WP_SITEURL','http://localhost/cms');
  cms2:
    image: wordpress
    volumes:
      - ./wp/:/var/www/html/
    environment:
      - WORDPRESS_DB_HOST=database
      - WORDPRESS_DB_USER=${db_user}
      - WORDPRESS_DB_PASSWORD=${db_pass}
      - WORDPRESS_DB_NAME=${db_name}
      - WORDPRESS_TABLE_PREFIX=wp
      - WORDPRESS_CONFIG_EXTRA=define('WP_HOME','http://localhost/cms');define('WP_SITEURL','http://localhost/cms');
  cms3:
    image: wordpress
    volumes:
      - ./wp/:/var/www/html/
    environment:
      - WORDPRESS_DB_HOST=database
      - WORDPRESS_DB_USER=${db_user}
      - WORDPRESS_DB_PASSWORD=${db_pass}
      - WORDPRESS_DB_NAME=${db_name}
      - WORDPRESS_TABLE_PREFIX=wp
      - WORDPRESS_CONFIG_EXTRA=define('WP_HOME','http://localhost/cms');define('WP_SITEURL','http://localhost/cms');
  database:
    image: mysql
    volumes:
      - ./db/:/var/lib/mysql/
    environment:
       - MYSQL_RANDOM_ROOT_PASSWORD=yes
       - MYSQL_DATABASE=${db_name}
       - MYSQL_USER=${db_user}
       - MYSQL_PASSWORD=${db_pass}
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h localhost -u $$MYSQL_USER --password=$$MYSQL_PASSWORD"]
      interval: 2s
      start_period: 30s
  apache:
    build: ./build/
